[
  { "id": "era-1955-liangpiao", "year": 1955, "scope": "national", "titleHint": "粮票年代", "text": "出生那年，粮店门口的队伍排得很长。家里的米面油都要凭票，母亲把一沓票证用橡皮筋捆好，压在樟木箱最底层，谁也不许乱动。", "deltas3": { "worldview": 1 }, "resourceDeltas": { "mood": -1 }, "stageFit": ["infant", "toddler", "childhood"], "checkStatus": "✅已核对" },
  { "id": "era-1956-heying", "year": 1956, "scope": "national", "titleHint": "公私合营", "text": "巷口的绸布庄换了新招牌，敲锣打鼓贴了红纸。大人们说铺子归了公家，往后买东西还是那些柜台，只是账本换了主人。", "deltas3": { "worldview": 1 }, "resourceDeltas": {}, "stageFit": ["infant", "toddler", "childhood"], "checkStatus": "✅已核对" },
  { "id": "era-1957-bridge", "year": 1957, "scope": "national", "titleHint": "大桥通车", "text": "广播里说，长江上要通火车了。父亲把收音机的音量拧大，全院的人挤过来听，孩子们围着报纸上大桥的图画指指点点。", "deltas3": { "worldview": 1 }, "resourceDeltas": { "mood": 1 }, "stageFit": ["infant", "toddler", "childhood", "teen"], "checkStatus": "✅已核对" },
  { "id": "era-1958-steel", "year": 1958, "scope": "national", "titleHint": "小土炉", "text": "家家院里砌了小土炉，铁锅铁勺都捐了出去。夜里炉火映红半条街，你趴在窗台上看，觉得像过年。", "deltas3": { "values": 1 }, "resourceDeltas": { "mood": -1 }, "stageFit": ["infant", "toddler", "childhood"], "checkStatus": "✅已核对" },
  { "id": "era-1959-decade", "year": 1959, "scope": "national", "titleHint": "十年国庆", "text": "十年国庆的游行队伍走了一整天，纸花铺满街道。家里的搪瓷杯上印着纪念字样，被擦得锃亮，来了客人才能拿出来用。", "deltas3": { "outlook": 1 }, "resourceDeltas": { "mood": 2 }, "stageFit": ["toddler", "childhood", "teen"], "checkStatus": "✅已核对" },
  { "id": "era-1960-lean", "year": 1960, "scope": "national", "titleHint": "紧日子", "text": "那几年餐桌变得很简单，粗粮和野菜成了主角。母亲把一个窝头掰成三份，说小孩长身体，多吃半口。", "deltas3": {}, "resourceDeltas": { "mood": -4, "health": -2 }, "stageFit": ["toddler", "childhood", "teen"], "checkStatus": "典型值" },
  { "id": "era-1961-return", "year": 1961, "scope": "national", "titleHint": "回乡去", "text": "城里的亲戚拖家带口回了乡下，临走前把缝纫机寄放在你家。姑妈说乡下有自留地，饿不着，等年成好了就回来。", "deltas3": { "values": 1 }, "resourceDeltas": { "mood": -2 }, "stageFit": ["toddler", "childhood", "teen"], "checkStatus": "典型值" },
  { "id": "era-1962-market", "year": 1962, "scope": "national", "titleHint": "集市又开", "text": "农村集市悄悄活了过来，筐里的鸡蛋和花生重新出现。奶奶用几个鸡蛋换回一包针线，走回家时脚步很轻快。", "deltas3": { "outlook": 1 }, "resourceDeltas": { "mood": 2 }, "stageFit": ["toddler", "childhood", "teen", "youth"], "checkStatus": "典型值" },
  { "id": "era-1963-leifeng", "year": 1963, "scope": "national", "titleHint": "学好人", "text": "大街小巷都在传一本日记。学校组织去扫街、扶老人，你把捡到的一分钱交给老师，得了一朵小红花，别在胸前好几天。", "deltas3": { "values": 2 }, "resourceDeltas": { "mood": 1 }, "stageFit": ["childhood", "teen", "youth"], "checkStatus": "✅已核对" },
  { "id": "era-1964-mushroom", "year": 1964, "scope": "national", "titleHint": "东方巨响", "text": "一声东方巨响通过广播传遍全国，院子里鞭炮齐鸣。大人把报纸头条念了一遍又一遍，说咱们腰杆挺直了。", "deltas3": { "worldview": 1, "outlook": 1 }, "resourceDeltas": { "mood": 3 }, "stageFit": ["childhood", "teen", "youth", "adult"], "checkStatus": "✅已核对" },
  { "id": "era-1965-sanxian", "year": 1965, "scope": "national", "titleHint": "去山里", "text": "有些人家的父亲收拾铺盖去了山里，说是支援内地建设。通信很慢，一封信要走半个月，信封上的邮戳盖着陌生的地名。", "deltas3": { "values": 1 }, "resourceDeltas": {}, "stageFit": ["childhood", "teen", "youth", "adult"], "checkStatus": "典型值" },
  { "id": "era-1966-class", "year": 1966, "scope": "national", "titleHint": "停课又复", "text": "学校的课停了又复，复了又停。操场上的标语换了新的，课本被压进箱底，老师在讲台上欲言又止。", "deltas3": { "worldview": -1 }, "resourceDeltas": { "mood": -3 }, "stageFit": ["childhood", "teen", "youth"], "checkStatus": "典型值" },
  { "id": "era-1967-opera", "year": 1967, "scope": "national", "titleHint": "样板戏", "text": "街头的高音喇叭从早到晚放着几出戏，人人都能哼上两句。你趴在戏台前看武打翻跟头，散场了还不想走。", "deltas3": { "worldview": 1 }, "resourceDeltas": { "mood": 1 }, "stageFit": ["childhood", "teen", "youth", "adult"], "checkStatus": "✅已核对" },
  { "id": "era-1968-xiaxiang", "year": 1968, "scope": "national", "titleHint": "上山下乡", "text": "锣鼓声中，一列列火车把青年送往远方。站台上哭声和歌声混在一起，大孩子留下的旧课本，落在了长椅上。", "deltas3": { "values": 1, "outlook": -1 }, "resourceDeltas": { "mood": -2 }, "stageFit": ["teen", "youth", "adult"], "checkStatus": "✅已核对" },
  { "id": "era-1969-moon", "year": 1969, "scope": "international", "titleHint": "月上有人", "text": "收音机里说，有人类落在了月亮上。夏夜乘凉，大人们指着月亮争论上面的脚印，孩子们听得入了迷。", "deltas3": { "worldview": 2 }, "resourceDeltas": { "mood": 1 }, "stageFit": ["teen", "youth", "adult", "midlife"], "checkStatus": "✅已核对" },
  { "id": "era-1970-satellite", "year": 1970, "scope": "national", "titleHint": "会唱歌的星", "text": "一颗会唱歌的卫星从夜空划过，全国仰着头听那支曲子。父亲搬出竹床，一家人在院子里守到后半夜。", "deltas3": { "worldview": 1, "outlook": 1 }, "resourceDeltas": { "mood": 2 }, "stageFit": ["childhood", "teen", "youth", "adult"], "checkStatus": "✅已核对" },
  { "id": "era-1971-pingpong", "year": 1971, "scope": "national", "titleHint": "小球转动", "text": "小小银球转动了世界。学校的水泥球台从此排起长队，一块木板削成的球拍，也能打一下午。", "deltas3": { "worldview": 1 }, "resourceDeltas": { "mood": 1 }, "stageFit": ["childhood", "teen", "youth", "adult"], "checkStatus": "✅已核对" },
  { "id": "era-1972-thaw", "year": 1972, "scope": "national", "titleHint": "破冰来访", "text": "美国总统的专机落在了北京，报纸头版印着握手的照片。大人们围着收音机听新闻，都觉得世道要变了。", "deltas3": { "worldview": 2 }, "resourceDeltas": {}, "stageFit": ["childhood", "teen", "youth", "adult"], "checkStatus": "✅已核对" },
  { "id": "era-1973-rice", "year": 1973, "scope": "national", "titleHint": "稻穗沉了", "text": "田里的稻穗比往年沉了许多，农技员蹲在田埂上做记录。吃饭这件天大的事，慢慢有了底气。", "deltas3": { "outlook": 1 }, "resourceDeltas": { "mood": 1 }, "stageFit": ["childhood", "teen", "youth", "adult", "midlife"], "checkStatus": "✅已核对" },
  { "id": "era-1974-tables", "year": 1974, "scope": "national", "titleHint": "水泥球台", "text": "水泥球台是全部的游乐场，五分钱的球能打到手心发烫。输球的人蹲在地上刮球拍，赢球的把球高高抛起。", "deltas3": { "outlook": 1 }, "resourceDeltas": { "mood": 2 }, "stageFit": ["childhood", "teen", "youth"], "checkStatus": "典型值" },
  { "id": "era-1975-modern", "year": 1975, "scope": "national", "titleHint": "四个现代化", "text": "大会重提了四个现代化，工厂的宣传栏刷了新标语。师傅们干活时话多了起来，都说好日子在后头。", "deltas3": { "outlook": 2 }, "resourceDeltas": { "mood": 1 }, "stageFit": ["teen", "youth", "adult", "midlife"], "checkStatus": "✅已核对" },
  { "id": "era-1976-annus", "year": 1976, "scope": "national", "titleHint": "多事之年", "text": "那一年噩耗一个接一个，地震的消息传来时，满街的人围着报纸沉默。秋天过后，风向慢慢变了。", "deltas3": { "values": 1 }, "resourceDeltas": { "mood": -4 }, "stageFit": ["childhood", "teen", "youth", "adult"], "checkStatus": "典型值" },
  { "id": "era-1977-gaokao", "year": 1977, "scope": "national", "titleHint": "高考回来", "text": "停了十一年的高考回来了。印刷厂连夜赶印试卷，无数人从箱底翻出课本，在油灯下重新拿起笔。", "deltas3": { "worldview": 2, "outlook": 2 }, "resourceDeltas": { "mood": 2 }, "stageFit": ["teen", "youth", "adult", "midlife"], "checkStatus": "✅已核对" },
  { "id": "era-1978-reform", "year": 1978, "scope": "national", "titleHint": "改革之年", "text": "一场大会之后，「改革」成了最热的词。农村分了地，城里开了个体户的口子，收音机里的调子也轻快了。", "deltas3": { "outlook": 2, "values": 1 }, "resourceDeltas": { "mood": 2 }, "stageFit": ["teen", "youth", "adult", "midlife", "elder"], "checkStatus": "✅已核对" },
  { "id": "era-1979-onechild", "year": 1979, "scope": "national", "titleHint": "独生一代", "text": "计划生育提上了日程，居委会开始挨家宣传。独生子女的证件发下来，家里把仅有的那张书桌留给了你。", "deltas3": { "values": 1 }, "resourceDeltas": {}, "stageFit": ["youth", "adult", "midlife"], "checkStatus": "✅已核对" },
  { "id": "era-1980-sez", "year": 1980, "scope": "national", "titleHint": "南方特区", "text": "南方一个小渔村成了特区，地图上被圈了红圈。有人说那边「时间就是金钱」，年轻人开始往南看。", "deltas3": { "outlook": 2 }, "resourceDeltas": { "mood": 1 }, "stageFit": ["teen", "youth", "adult", "midlife"], "checkStatus": "✅已核对" },
  { "id": "era-1981-volley", "year": 1981, "scope": "national", "titleHint": "女排夺冠", "text": "女排姑娘第一次捧起世界冠军，整条街的搪瓷缸敲成了锣。深夜的巷子里有人喊「赢了」，家家户户都亮着灯。", "deltas3": { "values": 2 }, "resourceDeltas": { "mood": 4 }, "stageFit": ["childhood", "teen", "youth", "adult", "midlife"], "checkStatus": "✅已核对" },
  { "id": "era-1982-tvset", "year": 1982, "scope": "national", "titleHint": "电视进家", "text": "十二寸的黑白电视搬进堂屋，全院的人自带板凳来看。天线要一个人在房顶上转，屋里的人喊着「清楚了别动」。", "deltas3": { "worldview": 1 }, "resourceDeltas": { "mood": 2 }, "stageFit": ["childhood", "teen", "youth", "adult"], "checkStatus": "典型值" },
  { "id": "era-1983-gala", "year": 1983, "scope": "national", "titleHint": "春晚开播", "text": "第一台春节联欢晚会火了，相声和小品让全家笑出眼泪。年夜饭从桌上挪到电视机前，饺子都煮过了火候。", "deltas3": { "values": 1 }, "resourceDeltas": { "mood": 3 }, "stageFit": ["childhood", "teen", "youth", "adult"], "checkStatus": "✅已核对" },
  { "id": "era-1984-gold", "year": 1984, "scope": "national", "titleHint": "奥运首金", "text": "大洋彼岸传回首金的枪声，广播里一遍遍重播国歌。学校的黑板报连夜换了标题，体育课报名的人排起了队。", "deltas3": { "outlook": 2, "values": 1 }, "resourceDeltas": { "mood": 3 }, "stageFit": ["childhood", "teen", "youth", "adult"], "checkStatus": "✅已核对" },
  { "id": "era-1985-suit", "year": 1985, "scope": "national", "titleHint": "脱下蓝灰", "text": "压箱底的蓝灰衣裳让位给了西装和红裙子，街上第一次有了颜色。裁缝铺的预约排到一个月后。", "deltas3": { "values": 1 }, "resourceDeltas": { "mood": 1 }, "stageFit": ["teen", "youth", "adult", "midlife"], "checkStatus": "典型值" },
  { "id": "era-1986-comet", "year": 1986, "scope": "international", "titleHint": "彗星来了", "text": "七十六年一遇的彗星拖着长尾扫过夜空。天文台的望远镜前排起长队，你用纸筒做了一支「望远镜」，也对准了东南方。", "deltas3": { "worldview": 2 }, "resourceDeltas": { "mood": 1 }, "stageFit": ["childhood", "teen", "youth", "adult"], "checkStatus": "✅已核对" },
  { "id": "era-1987-tape", "year": 1987, "scope": "national", "titleHint": "磁带歌潮", "text": "双卡录音机里转着翻录的磁带，巷口的青年跟着音箱练舞步。你攒了两个月的零花钱，在音像柜台前挑了一下午。", "deltas3": { "values": 1 }, "resourceDeltas": { "mood": 2 }, "stageFit": ["childhood", "teen", "youth", "adult"], "checkStatus": "典型值" },
  { "id": "era-1988-panic", "year": 1988, "scope": "national", "titleHint": "抢购潮", "text": "物价闯关的消息一出，商店被抢得只剩货架。母亲拖回两箱火柴和一桶盐，说钱要毛了，东西才是真的。", "deltas3": { "values": -1 }, "resourceDeltas": { "mood": -2 }, "stageFit": ["teen", "youth", "adult", "midlife"], "checkStatus": "✅已核对" },
  { "id": "era-1989-bikes", "year": 1989, "scope": "national", "titleHint": "自行车流", "text": "早晚高峰的十字路口，自行车的洪流等在白线后，绿灯一亮铃声响成一片。分配名单贴在系馆门口，有人欢喜有人沉默。", "deltas3": { "worldview": 1 }, "resourceDeltas": {}, "stageFit": ["teen", "youth", "adult"], "checkStatus": "典型值" },
  { "id": "era-1990-asian", "year": 1990, "scope": "national", "titleHint": "北京亚运", "text": "亚运会来到北京，熊猫盼盼贴满了橱窗。全校做体操都有了个新名目——为国争光。", "deltas3": { "values": 1, "outlook": 1 }, "resourceDeltas": { "mood": 2 }, "stageFit": ["childhood", "teen", "youth", "adult"], "checkStatus": "✅已核对" },
  { "id": "era-1991-gulf", "year": 1991, "scope": "international", "titleHint": "直播战争", "text": "第一次在电视直播里看见战争，夜空的火光震住了整间屋子。人们围着屏幕，头一回意识到世界装进了画面。", "deltas3": { "worldview": 2 }, "resourceDeltas": { "mood": -1 }, "stageFit": ["teen", "youth", "adult", "midlife"], "checkStatus": "✅已核对" },
  { "id": "era-1992-south", "year": 1992, "scope": "national", "titleHint": "下海去", "text": "南方谈话传遍全国，「下海」成了年度热词。单位里最稳的会计辞了职，办公室空出来的椅子越来越多。", "deltas3": { "outlook": 2 }, "resourceDeltas": { "mood": 1 }, "stageFit": ["teen", "youth", "adult", "midlife", "elder"], "checkStatus": "✅已核对" },
  { "id": "era-1993-noticket", "year": 1993, "scope": "national", "titleHint": "粮票谢幕", "text": "沿用近四十年的粮票悄悄停用，饭桌从此不再凭票。奶奶把剩下的票证收进铁盒：往后，挨饿只在故事里了。", "deltas3": { "worldview": 1, "outlook": 1 }, "resourceDeltas": { "mood": 2 }, "stageFit": ["childhood", "teen", "youth", "adult", "midlife"], "checkStatus": "✅已核对" },
  { "id": "era-1994-league", "year": 1994, "scope": "national", "titleHint": "职业联赛", "text": "职业足球联赛开哨，球场的呐喊声第一次按秒计价。男生们把球星海报贴上床头，课间争论的全是阵型。", "deltas3": { "values": 1 }, "resourceDeltas": { "mood": 2 }, "stageFit": ["childhood", "teen", "youth", "adult"], "checkStatus": "✅已核对" },
  { "id": "era-1995-weekend", "year": 1995, "scope": "national", "titleHint": "双休日", "text": "双休日来了，一家人第一次有了完整的两天。电视机前的棋谱讲座、公园里的风筝，多出来的时间让人不知所措。", "deltas3": { "outlook": 1 }, "resourceDeltas": { "mood": 2 }, "stageFit": ["childhood", "teen", "youth", "adult", "midlife", "elder"], "checkStatus": "✅已核对" },
  { "id": "era-1996-pc", "year": 1996, "scope": "national", "titleHint": "家用电脑", "text": "大脑袋电脑搬进了书房，开机要等上两分钟。孩子教父母用鼠标，长辈握鼠标的样子，像端着一只茶碗。", "deltas3": { "worldview": 1 }, "resourceDeltas": {}, "stageFit": ["childhood", "teen", "youth", "adult"], "checkStatus": "典型值" },
  { "id": "era-1997-hk", "year": 1997, "scope": "national", "titleHint": "香港回归", "text": "交接仪式那晚，全家守到深夜。零点钟声一响，电视里的国旗升起，父亲把音量开到最大。", "deltas3": { "values": 2 }, "resourceDeltas": { "mood": 3 }, "stageFit": ["childhood", "teen", "youth", "adult", "midlife"], "checkStatus": "✅已核对" },
  { "id": "era-1998-housing", "year": 1998, "scope": "national", "titleHint": "房改之年", "text": "福利分房停了，商品房的广告爬满报纸。单位宿舍的邻居开始看样板间，「买房」从单位的事变成了自己的事。", "deltas3": { "worldview": 1, "values": -1 }, "resourceDeltas": { "mood": -1 }, "stageFit": ["youth", "adult", "midlife"], "checkStatus": "✅已核对" },
  { "id": "era-1999-macau", "year": 1999, "scope": "national", "titleHint": "澳门回归", "text": "又一朵莲花开了回来，世纪末的钟声近了。大街小巷放着那首歌，连幼儿园都在排演合唱。", "deltas3": { "values": 1 }, "resourceDeltas": { "mood": 2 }, "stageFit": ["childhood", "teen", "youth", "adult", "midlife"], "checkStatus": "✅已核对" },
  { "id": "era-2000-millennium", "year": 2000, "scope": "international", "titleHint": "千禧年", "text": "全世界一起数着秒跨进新千年，电视里转播着各地的烟花。有人守在电脑前，紧张地等着传说中的「千年虫」发作。", "deltas3": { "worldview": 2 }, "resourceDeltas": { "mood": 2 }, "stageFit": ["childhood", "teen", "youth", "adult", "midlife", "elder"], "checkStatus": "✅已核对" },
  { "id": "era-2001-wto", "year": 2001, "scope": "national", "titleHint": "双喜之年", "text": "夏夜的投票现场念出「北京」两个字，街道瞬间沸腾。年底又传来入世的消息，报纸说：我们融入世界了。", "deltas3": { "values": 2, "outlook": 1 }, "resourceDeltas": { "mood": 3 }, "stageFit": ["childhood", "teen", "youth", "adult", "midlife"], "checkStatus": "✅已核对" },
  { "id": "era-2002-worldcup", "year": 2002, "scope": "national", "titleHint": "首进世界杯", "text": "中国队第一次踢进世界杯，学校提前放学看球。出线那晚的鞭炮声，比过年还密。", "deltas3": { "values": 1 }, "resourceDeltas": { "mood": 3 }, "stageFit": ["childhood", "teen", "youth", "adult"], "checkStatus": "✅已核对" },
  { "id": "era-2003-sars", "year": 2003, "scope": "national", "titleHint": "口罩那年", "text": "一场疫情让城市安静下来，口罩第一次成了出门标配。学校停课，楼道里飘着消毒水的味道，体温计成了家里的新成员。", "deltas3": { "worldview": 1 }, "resourceDeltas": { "mood": -4, "health": -2 }, "stageFit": ["childhood", "teen", "youth", "adult"], "checkStatus": "✅已核对" },
  { "id": "era-2004-cafe", "year": 2004, "scope": "national", "titleHint": "网吧年代", "text": "街角的网吧彻夜亮着灯，屏幕上小企鹅闪个不停。「网上冲浪」是个新词，机房的鞋套要排队领。", "deltas3": { "worldview": 1 }, "resourceDeltas": { "mood": 1 }, "stageFit": ["childhood", "teen", "youth"], "checkStatus": "典型值" },
  { "id": "era-2005-idol", "year": 2005, "scope": "national", "titleHint": "选秀热", "text": "一档平民选秀让全国观众拿起手机投票，街头巷尾都在谈论那个唱到哽咽的女孩。校园里人手一句「想唱就唱」。", "deltas3": { "values": 1, "outlook": 1 }, "resourceDeltas": { "mood": 2 }, "stageFit": ["childhood", "teen", "youth", "adult"], "checkStatus": "✅已核对" },
  { "id": "era-2006-tax", "year": 2006, "scope": "national", "titleHint": "皇粮免了", "text": "延续两千六百年的农业税取消了，村里的大喇叭广播了三遍。爷爷蹲在田埂上抽完一袋烟，说这在从前想都不敢想。", "deltas3": { "values": 1, "outlook": 1 }, "resourceDeltas": { "mood": 2 }, "stageFit": ["youth", "adult", "midlife", "elder"], "checkStatus": "✅已核对" },
  { "id": "era-2007-iphone", "year": 2007, "scope": "international", "titleHint": "无键盘手机", "text": "一款没有键盘的手机问世，世界为之一愣。地铁里还都是按键机的咔哒声，没人想到几年后拇指会在玻璃上起舞。", "deltas3": { "worldview": 2 }, "resourceDeltas": {}, "stageFit": ["teen", "youth", "adult", "midlife"], "checkStatus": "✅已核对" },
  { "id": "era-2008-olympic", "year": 2008, "scope": "national", "titleHint": "眼泪与欢呼", "text": "这一年眼泪和欢呼一样多。南方的地震让全城鸣笛三分钟，两个月后开幕式的烟花照亮夜空，两种记忆刻在同一年。", "deltas3": { "values": 2, "worldview": 1 }, "resourceDeltas": { "mood": -2 }, "stageFit": ["childhood", "teen", "youth", "adult", "midlife"], "checkStatus": "✅已核对" },
  { "id": "era-2009-weibo", "year": 2009, "scope": "national", "titleHint": "围脖时代", "text": "一百四十字的碎碎念成了新的日记本，一条转发能掀起千层浪。饭桌上人人低头刷新，身边人成了「网友」。", "deltas3": { "worldview": 1 }, "resourceDeltas": { "mood": 1 }, "stageFit": ["teen", "youth", "adult", "midlife"], "checkStatus": "典型值" },
  { "id": "era-2010-expo", "year": 2010, "scope": "national", "titleHint": "上海世博", "text": "一场世博会的队伍排出几公里长，盖章的「世博护照」卖断了货。全家出游的照片里，人人脖子上都挂着相机。", "deltas3": { "worldview": 1 }, "resourceDeltas": { "mood": 2 }, "stageFit": ["childhood", "teen", "youth", "adult", "midlife"], "checkStatus": "✅已核对" },
  { "id": "era-2011-wechat", "year": 2011, "scope": "national", "titleHint": "微信来了", "text": "一个绿色对话框开始接管生活，语音条取代了短信拜年。除夕夜的家庭群第一次抢起红包，长辈也学会了发表情。", "deltas3": { "worldview": 1, "values": 1 }, "resourceDeltas": { "mood": 1 }, "stageFit": ["teen", "youth", "adult", "midlife"], "checkStatus": "✅已核对" },
  { "id": "era-2012-hsr", "year": 2012, "scope": "national", "titleHint": "高铁成网", "text": "高铁一寸寸铺开地图，朝发夕至改写成朝发午至。春运的绿皮车渐渐成了回忆，车厢里的泡面味淡了。", "deltas3": { "worldview": 1, "outlook": 1 }, "resourceDeltas": { "mood": 2 }, "stageFit": ["teen", "youth", "adult", "midlife", "elder"], "checkStatus": "✅已核对" },
  { "id": "era-2013-lte", "year": 2013, "scope": "national", "titleHint": "4G 元年", "text": "4G 牌照发放，视频通话不再卡顿。便利店柜台悄悄立起扫码的小牌子，扫码的人还寥寥无几。", "deltas3": { "worldview": 1 }, "resourceDeltas": {}, "stageFit": ["teen", "youth", "adult", "midlife"], "checkStatus": "✅已核对" },
  { "id": "era-2014-pay", "year": 2014, "scope": "national", "titleHint": "扫码付钱", "text": "出门只带手机成了新习惯，菜市场的鱼摊前也挂起了二维码。老人把付款码打印出来压在玻璃板下，逢人便问「扫哪个」。", "deltas3": { "worldview": 1 }, "resourceDeltas": { "mood": 1 }, "stageFit": ["teen", "youth", "adult", "midlife", "elder"], "checkStatus": "典型值" },
  { "id": "era-2015-twochild", "year": 2015, "scope": "national", "titleHint": "二孩来了", "text": "独生子女政策落幕，全面二孩放开。办公室的孕味话题多了起来，独生的一代开始讨论要不要给娃添个伴。", "deltas3": { "values": 1 }, "resourceDeltas": {}, "stageFit": ["youth", "adult", "midlife"], "checkStatus": "✅已核对" },
  { "id": "era-2016-alphago", "year": 2016, "scope": "international", "titleHint": "AI 落子", "text": "人工智能在围棋盘上赢了人类顶尖棋手，全球哗然。茶余饭后都在讨论机器比人聪明了怎么办，孩子们只关心那步「神之一手」。", "deltas3": { "worldview": 2 }, "resourceDeltas": { "mood": 1 }, "stageFit": ["teen", "youth", "adult", "midlife"], "checkStatus": "✅已核对" },
  { "id": "era-2017-bike", "year": 2017, "scope": "national", "titleHint": "共享单车", "text": "橙的黄的蓝的单车一夜之间涌上街头，扫码即走的方便让人惊喜。后来堆积如山的废旧单车，也成了街角的一景。", "deltas3": { "worldview": 1 }, "resourceDeltas": { "mood": 1 }, "stageFit": ["teen", "youth", "adult", "midlife"], "checkStatus": "典型值" },
  { "id": "era-2018-clips", "year": 2018, "scope": "national", "titleHint": "短视频", "text": "十五秒的视频填满了所有等待的缝隙，人人都能拍、人人都在刷。家里的电视开了机，却没人抬头看。", "deltas3": { "worldview": -1 }, "resourceDeltas": { "mood": 1 }, "stageFit": ["teen", "youth", "adult", "midlife"], "checkStatus": "典型值" },
  { "id": "era-2019-fiveg", "year": 2019, "scope": "national", "titleHint": "5G 商用", "text": "5G 牌照发放，「万物互联」写进了新闻标题。测速视频刷了屏，人们第一次为看不见的网速激动。", "deltas3": { "worldview": 1 }, "resourceDeltas": { "mood": 1 }, "stageFit": ["teen", "youth", "adult", "midlife"], "checkStatus": "✅已核对" },
  { "id": "era-2020-covid", "year": 2020, "scope": "national", "titleHint": "口罩回来", "text": "疫情让世界按了暂停键，口罩时隔十七年再次成为出门标配。网课、健康码、核酸排队，构成了这一年的集体记忆。", "deltas3": { "worldview": 1, "values": 1 }, "resourceDeltas": { "mood": -5, "health": -2 }, "stageFit": ["childhood", "teen", "youth", "adult", "midlife", "elder"], "checkStatus": "✅已核对" },
  { "id": "era-2021-station", "year": 2021, "scope": "national", "titleHint": "空间站", "text": "自家的空间站核心舱升空，航天员开始了长期驻守。孩子仰着头问：从天上能看见我们家的阳台吗？", "deltas3": { "worldview": 2, "outlook": 1 }, "resourceDeltas": { "mood": 2 }, "stageFit": ["childhood", "teen", "youth", "adult", "midlife"], "checkStatus": "✅已核对" },
  { "id": "era-2022-winter", "year": 2022, "scope": "national", "titleHint": "双奥之城", "text": "冰雪盛会点亮立春之夜，吉祥物一只难求。冠军们带火了雪场，南方的室内滑雪场也排起了队。", "deltas3": { "values": 1, "outlook": 1 }, "resourceDeltas": { "mood": 3 }, "stageFit": ["childhood", "teen", "youth", "adult", "midlife"], "checkStatus": "✅已核对" },
  { "id": "era-2023-llm", "year": 2023, "scope": "international", "titleHint": "AI 浪潮", "text": "会聊天的 AI 一夜爆红，写邮件、改代码、编故事样样都行。饭桌上第一次认真讨论：哪些饭碗是铁的，哪些不是。", "deltas3": { "worldview": 2 }, "resourceDeltas": { "mood": 1 }, "stageFit": ["teen", "youth", "adult", "midlife", "elder"], "checkStatus": "✅已核对" },
  { "id": "era-2024-paris", "year": 2024, "scope": "international", "titleHint": "巴黎奥运", "text": "塞纳河上的开幕式让奥运第一次走出场馆，深夜的中国客厅灯火通明。乒乓球的金牌榜又一次被刷屏。", "deltas3": { "values": 1 }, "resourceDeltas": { "mood": 2 }, "stageFit": ["childhood", "teen", "youth", "adult", "midlife"], "checkStatus": "✅已核对" },
  { "id": "era-2025-assistant", "year": 2025, "scope": "international", "titleHint": "AI 助手", "text": "AI 助手成了家里的新成员：提醒吃药、辅导作业、陪老人聊天。孩子第一次作业得了优，被追问是不是 AI 教的。", "deltas3": { "worldview": 1 }, "resourceDeltas": { "mood": 1 }, "stageFit": ["teen", "youth", "adult", "midlife", "elder"], "checkStatus": "典型值" },
  { "id": "era-2026-milan", "year": 2026, "scope": "international", "titleHint": "米兰冬奥", "text": "意大利的冰雪盛会如期而至，时差让熬夜观赛成了常态。短视频里的夺冠瞬间，总比直播快上一步。", "deltas3": { "values": 1 }, "resourceDeltas": { "mood": 2 }, "stageFit": ["childhood", "teen", "youth", "adult", "midlife"], "checkStatus": "✅已核对" },
  { "id": "era-2027-glasses", "year": 2027, "scope": "national", "titleHint": "智能眼镜", "text": "智能眼镜开始出现在地铁车厢，导航箭头直接画在马路上。老人还是习惯把手机音量开到最大，念出每一条提示。", "deltas3": { "worldview": 1 }, "resourceDeltas": {}, "stageFit": ["teen", "youth", "adult", "midlife", "elder"], "checkStatus": "典型值" },
  { "id": "era-2028-robot", "year": 2028, "scope": "national", "titleHint": "养老机器人", "text": "居家养老机器人进了社区试点，帮忙取药、扶人起身。儿女远程视频查岗，机器人在旁边一声不响地让开镜头。", "deltas3": { "values": 1 }, "resourceDeltas": { "mood": 1 }, "stageFit": ["youth", "adult", "midlife", "elder"], "checkStatus": "典型值" },
  { "id": "era-2029-ev", "year": 2029, "scope": "national", "titleHint": "油站改行", "text": "新能源车充一次电跑的里程又刷新了，加油站开始改行卖咖啡。驾校教练成了热门职业——专教人接管自动驾驶。", "deltas3": { "worldview": 1 }, "resourceDeltas": {}, "stageFit": ["teen", "youth", "adult", "midlife"], "checkStatus": "典型值" },
  { "id": "era-2030-carbon", "year": 2030, "scope": "national", "titleHint": "碳达峰之年", "text": "承诺的碳达峰大年到了，更蓝的天成了看得见的成绩单。城区有整月整月的蓝天，孩子在自然课上传看父辈拍的灰照片。", "deltas3": { "worldview": 1, "outlook": 1 }, "resourceDeltas": { "mood": 2 }, "stageFit": ["youth", "adult", "midlife", "elder"], "checkStatus": "✅已核对" }
]
