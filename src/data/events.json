[
  {
    "id": "infant-001",
    "stage": "infant",
    "type": "main",
    "ageHint": "1岁",
    "text": "你睁开眼，世界是一片模糊的暖色。摇篮上方挂着一只会转的布偶铃，家人轮番凑过来逗你。",
    "options": [
      {
        "text": "咿咿呀呀地大声回应，挥着小手要人抱",
        "deltas": { "ei": 2, "tf": 1 },
        "aftermath": "全家人都被逗笑了，你成了饭桌上的小主角。"
      },
      {
        "text": "安静地盯着那只布偶铃，自己看得入神",
        "deltas": { "sn": 1, "jp": 1 }
      }
    ]
  },
  {
    "id": "infant-002",
    "stage": "infant",
    "type": "context",
    "ageHint": "2岁",
    "text": "深夜你发起低烧，客厅的灯亮到天明，大人们围着体温计团团转。",
    "options": [
      {
        "text": "难受得大哭，只有被抱在怀里才能睡去",
        "deltas": { "ei": 2, "tf": 1 }
      },
      {
        "text": "蔫蔫地不哭不闹，喂药就乖乖咽下去",
        "deltas": { "jp": 2, "sn": 1 }
      }
    ]
  },
  {
    "id": "toddler-001",
    "stage": "toddler",
    "type": "main",
    "ageHint": "5岁",
    "text": "幼儿园的沙池边，一个高你半头的孩子一把抢走了你挖了很久的塑料铲子。",
    "options": [
      {
        "text": "冲上去把铲子抢回来",
        "deltas": { "ei": 2, "tf": -1 },
        "flag": "rebel",
        "aftermath": "你俩扭作一团，老师把你们各批评了一顿——但铲子回到了你手里。"
      },
      {
        "text": "跑去告诉老师，请她评理",
        "deltas": { "jp": 2, "tf": 1 },
        "flag": "conform"
      }
    ]
  },
  {
    "id": "toddler-002",
    "stage": "toddler",
    "type": "context",
    "ageHint": "4岁",
    "text": "家里给你买了一盒崭新的蜡笔，雪白的墙在你看来是一张等了很久的大画纸。",
    "options": [
      {
        "text": "踮着脚在墙上画满歪歪扭扭的太阳",
        "deltas": { "sn": 2, "ei": 1 },
        "aftermath": "这面墙后来被一张挂历遮住，成了家族相册里的著名景点。"
      },
      {
        "text": "摊开图画本，照着样子一笔一笔描",
        "deltas": { "jp": 2, "sn": -1 }
      }
    ]
  },
  {
    "id": "childhood-001",
    "stage": "childhood",
    "type": "main",
    "ageHint": "10岁",
    "text": "新学期班会，班主任在黑板上写下“班干部竞选”几个字，教室里嗡的一声议论开了。",
    "options": [
      {
        "text": "第一个举手，上台把想说的话全说了",
        "deltas": { "ei": 3, "jp": 1 }
      },
      {
        "text": "低着头在草稿纸上把竞选纲领列了一遍又一遍，最终没有上台",
        "deltas": { "ei": -2, "tf": 1 }
      }
    ]
  },
  {
    "id": "childhood-002",
    "stage": "childhood",
    "type": "context",
    "ageHint": "8岁",
    "text": "期中卷子发下来，你考了全班第一。放学的路忽然变得特别短。",
    "options": [
      {
        "text": "一路小跑进家门，卷子举得比头还高",
        "deltas": { "ei": 2, "tf": 1 }
      },
      {
        "text": "把卷子对折夹进课本，想等吃晚饭时再“顺便”让它被发现",
        "deltas": { "ei": -1, "jp": 1 }
      }
    ]
  },
  {
    "id": "teen-001",
    "stage": "teen",
    "type": "main",
    "ageHint": "16岁",
    "text": "文理分科的志愿表发下来。家人围在饭桌上反复念叨：学理，好找工作。可你真正舍不得的，是语文课本里那些没讲完的故事。",
    "options": [
      {
        "text": "背着家人把文科填在了第一栏",
        "deltas": { "sn": 1, "tf": 1 },
        "flag": "rebel",
        "aftermath": "交表那天你在走廊里靠了很久——那是你第一次自己拿大主意。"
      },
      {
        "text": "听了家里的安排",
        "deltas": { "jp": 1, "sn": -1 },
        "flag": "conform"
      }
    ]
  },
  {
    "id": "teen-002",
    "stage": "teen",
    "type": "context",
    "ageHint": "17岁",
    "pre": ["rebel"],
    "text": "教务处的电话打到了家里——你当堂顶撞了年级主任。母亲挂了电话，屋里安静得能听见钟摆声。",
    "options": [
      {
        "text": "低头认错，心里却把那套道理又过了一遍，一句也没改",
        "deltas": { "tf": -1, "jp": 2 }
      },
      {
        "text": "把顶撞的理由原原本本再说一遍",
        "deltas": { "tf": 2, "ei": 1 },
        "flag": "rebel"
      }
    ]
  },
  {
    "id": "teen-003",
    "stage": "teen",
    "type": "critical",
    "ageHint": "18岁",
    "text": "高考志愿提交前的最后一晚。志愿表第一栏空着——是留在离家两小时车程的省内，还是去两千公里外你只在地图上量过的城市？",
    "options": [
      {
        "text": "填下那所远方学校，行李箱当晚就拖出来试了试轮子",
        "deltas": { "ei": 3, "sn": 2, "jp": -2 },
        "flag": "wanderlust"
      },
      {
        "text": "选了省内那所，母亲连夜给你缝了床新被子",
        "deltas": { "jp": 3, "tf": -1 },
        "flag": "conform"
      }
    ]
  },
  {
    "id": "youth-001",
    "stage": "youth",
    "type": "main",
    "ageHint": "22岁",
    "text": "毕业季。手里一份家乡的稳定录用函，一个一线城市小公司的录用通知，截止日期都是这周五。",
    "options": [
      {
        "text": "拖着一个行李箱去了大城市，合租房的窗户正对着一堵墙",
        "deltas": { "ei": 2, "sn": 1, "jp": -1 }
      },
      {
        "text": "回老家报到，工位、食堂、宿舍三点一线",
        "deltas": { "jp": 3, "sn": -1 }
      }
    ]
  },
  {
    "id": "youth-002",
    "stage": "youth",
    "type": "context",
    "ageHint": "25岁",
    "pre": ["wanderlust"],
    "text": "公司内推的跨区域项目组向你招手：半年外派，去一个你没去过的地方。",
    "options": [
      {
        "text": "当天就回了“愿意”，收拾行李的速度比领导批流程还快",
        "deltas": { "ei": 2, "sn": 2 }
      },
      {
        "text": "犹豫了一晚，还是推掉了——你想先把日子过安稳",
        "deltas": { "jp": 2, "ei": -1 }
      }
    ]
  },
  {
    "id": "adult-001",
    "stage": "adult",
    "type": "main",
    "ageHint": "33岁",
    "text": "部门例会后领导把你留下：有个驻外岗位空缺，待遇翻番，但一去就是三年。",
    "options": [
      {
        "text": "接下驻外，把家里的钥匙托付给邻居",
        "deltas": { "ei": 2, "sn": 1, "jp": -1 }
      },
      {
        "text": "留在原岗，推掉了这次机会",
        "deltas": { "jp": 2, "tf": 1 }
      }
    ]
  },
  {
    "id": "adult-002",
    "stage": "adult",
    "type": "context",
    "ageHint": "38岁",
    "text": "孩子第一次上台表演和家长会排在同一天，而你负责的系统升级也定在当晚上线。",
    "options": [
      {
        "text": "把上线盯现场的担子交给副手，坐进了学校礼堂第三排",
        "deltas": { "tf": 3 }
      },
      {
        "text": "守在机房直到凌晨，演出是第二天看的录像",
        "deltas": { "jp": 2, "tf": -2 }
      }
    ]
  },
  {
    "id": "midlife-001",
    "stage": "midlife",
    "type": "main",
    "ageHint": "50岁",
    "text": "体检报告和人事调整通知同一天到手。公司劝你转岗做顾问——明升暗降，你心里门儿清。",
    "options": [
      {
        "text": "办了内退，拿着积蓄去折腾想了半辈子的小生意",
        "deltas": { "sn": 2, "ei": 1, "jp": -2 }
      },
      {
        "text": "接受转岗，守着资历安稳过渡到退休",
        "deltas": { "jp": 3, "sn": -1 }
      }
    ]
  },
  {
    "id": "midlife-002",
    "stage": "midlife",
    "type": "context",
    "ageHint": "55岁",
    "text": "毕业三十周年聚会，班长在群里艾特了所有人。你盯着手机想了很久。",
    "options": [
      {
        "text": "不但去了，还主动张罗了全场签到和合影",
        "deltas": { "ei": 2, "tf": 1 }
      },
      {
        "text": "去了，坐在靠边的位置，和老同桌聊了一整晚",
        "deltas": { "ei": -2, "sn": 1 }
      }
    ]
  },
  {
    "id": "elder-001",
    "stage": "elder",
    "type": "main",
    "ageHint": "70岁",
    "text": "退休证领回来压在抽屉底。小区门口的老年大学贴出了春季招生简章：书法、合唱、摄影，还有一门长途徒步。",
    "options": [
      {
        "text": "报了两门课，又偷偷在徒步报名表上添了名字",
        "deltas": { "sn": 2, "ei": 1 }
      },
      {
        "text": "什么班也没报，把阳台改成了小花园",
        "deltas": { "jp": 2, "ei": -1 }
      }
    ]
  },
  {
    "id": "elder-002",
    "stage": "elder",
    "type": "critical",
    "ageHint": "85岁",
    "text": "一场小病之后，儿女认真和你谈了一次：要不要卖掉老房子，搬去和他们同住？这个决定，会是你人生的最后一份答卷。",
    "options": [
      {
        "text": "守着自己的老房子，把钥匙多配了一把给邻居",
        "deltas": { "ei": -1, "jp": 3, "tf": 1 }
      },
      {
        "text": "答应了，把老照片一张一张收进随身的箱子",
        "deltas": { "ei": 2, "tf": 2 }
      }
    ]
  }
]
